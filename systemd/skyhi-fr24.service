[Unit]
Description=SkyHi hybrid RTL-SDR and Flightradar24 aircraft source
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shravanxd
Group=shravanxd
EnvironmentFile=/home/shravanxd/.config/skyhi/fr24.env
RuntimeDirectory=skyhi-fr24
RuntimeDirectoryMode=0755
ExecStart=/opt/skyhi/flight-display/.venv/bin/python /opt/skyhi/flight-display/fr24_poller.py --config /opt/skyhi/flight-display/config.json
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
